/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

# 首页必须实时可读：神马/百度等站长验证的 meta 标签在首页，
# 若命中部署前的旧缓存，爬虫会读到过期验证码导致验证失败。
/
  Cache-Control: no-store, no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/robots.txt
  Content-Type: text/plain
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

# 站长验证文件必须实时可读，禁止边缘缓存（否则部署前的 404 会被缓存，导致验证失败）。
/baidu_verify_codeva-Aehy6TlNkz.html
  Cache-Control: no-store, no-cache, must-revalidate

/0e0a5f795d2a1b8dabb148ce206896f3.txt
  Cache-Control: no-store, no-cache, must-revalidate

/sogousiteverification.txt
  Cache-Control: no-store, no-cache, must-revalidate

/ByteDanceVerify.html
  Cache-Control: no-store, no-cache, must-revalidate

/shenma-site-verification.txt
  Cache-Control: no-store, no-cache, must-revalidate

# IndexNow 密钥文件：必须实时可读，禁止缓存（否则部署前 404 被缓存会导致 403 key 无效）。
/420f5984a2434bd3b5f6e6805dc00281.txt
  Cache-Control: no-store, no-cache, must-revalidate
